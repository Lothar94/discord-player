# Discord bot token. Get one at https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# Command prefix used by the bot (default: !)
COMMAND_PREFIX=!

# Default volume on join, 0.0 to 1.0 (default: 0.5)
DEFAULT_VOLUME=0.5

# Logging level: DEBUG, INFO, WARNING, ERROR (default: INFO)
LOG_LEVEL=INFO

# Seconds of inactivity (no track playing) before the bot disconnects.
# Set to 0 to disable. (default: 300)
INACTIVITY_TIMEOUT_SECONDS=300

# Disconnect when all humans leave the voice channel. (default: true)
DISCONNECT_WHEN_ALONE=true

# Grace period in seconds before disconnecting from an empty channel.
# Set to 0 to disconnect immediately. (default: 60)
EMPTY_CHANNEL_GRACE_SECONDS=60
